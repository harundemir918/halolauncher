<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Uninstall from the long-press menu; the system still asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Optional: contacts in search, asked for only from search. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Android 15: lets the default home app see the private space. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- Optional: today's events on Home, asked for from Home. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Package visibility (Android 11+). -->
    <queries>
        <!-- Every app that has a launcher entry. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The default apps that fill the arc the first time. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application>
        <!-- Stream's notifications and the Switchboard media strip. The user
             grants it in Settings > Notification access. -->
        <service
            android:name=".HaloNotificationService"
            android:exported="true"
            android:label="Halo"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
