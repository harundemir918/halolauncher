<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown until Flutter draws its first frame. A launcher reappears often,
         so this is the Halo ground, never a white or black flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/halo_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- Behind the Flutter UI while it runs. No wallpaper: Halo draws an opaque ground. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/halo_ground</item>
        <item name="android:windowShowWallpaper">false</item>
        <!-- No system outline around the app on key events: Halo draws its
             own focus, and a stray outline would read as Volt. -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
